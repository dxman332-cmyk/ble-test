#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include "esp_bt.h"

// 嚴格對齊網頁所指定的官方範例 UUID
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

// 指定 C3-Zero 安全的繼電器引腳 (低電位觸發 LOW=通電)
#define RELAY_PIN 5  
#define RELAY_ACTIVE_LEVEL LOW
static const int RELAY_IDLE_LEVEL = (RELAY_ACTIVE_LEVEL == LOW) ? HIGH : LOW;

BLEServer *pServer = nullptr; // 提到全域，方便主動斷開

// 監聽藍牙傳來數據的回呼函式
class MyCallbacks: public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic *pCharacteristic) {
      String value = pCharacteristic->getValue().c_str();
      value.trim(); 

      if (value.length() > 0) {
        Serial.println("----------------------------------------------");
        Serial.print("[藍牙串口接收] 收到指令: \""); Serial.print(value); Serial.println("\"");
        
        // 判定開門字串
        if (value.equalsIgnoreCase("OPEN")) {
          Serial.println(">>> [驗證成功] 驅動大門解鎖 1.5 秒！ <<<");
          digitalWrite(RELAY_PIN, RELAY_ACTIVE_LEVEL); // 導通繼電器
        } else {
          Serial.println("[-] 密碼字串不符，拒絕開門。");
        }
        Serial.println("----------------------------------------------");
        
        // 【核心修改：破除快取死鎖】開門後立刻主動踢掉連線
        if (pServer != nullptr && pServer->getConnectedCount() > 0) {
          pServer->disconnect(0); 
          Serial.println("[藍牙] 已主動發起 GATT 斷開訊號...");
        }
        
        // 延遲 1.5 秒（維持開門時間，並給手機時間反應）
        delay(1500);                   
        
        // 暴力重啟！重啟時 setup() 會自動把繼電器關鎖，並徹底洗白手機的藍牙鎖死快取
        Serial.println(">>> 鎖具重置，晶片自動重啟刷新快取。 <<<");
        ESP.restart();
      }
    }
};

// 監聽手機連線狀態
class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      Serial.println("\n[系統通知] 手機已成功建立藍牙連線。");
    }
    void onDisconnect(BLEServer* pServer) {
      Serial.println("[系統通知] 手機已斷開藍牙連線。");
      pServer->startAdvertising(); // 斷線後重啟廣播雙重保險
    }
};

void setup() {
  // 開機第一件事立刻配置繼電器為「斷開不通電」狀態，防止重啟誤開門
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_IDLE_LEVEL); 

  Serial.begin(115200);
  delay(1000); 
  Serial.println("\n==============================================");
  Serial.println("=== Proton 門禁 [藍牙直接控制與重啟調試] 啟動 ===");
  Serial.println("==============================================");

  // 1. 初始化藍牙，名稱維持 _Gate
  BLEDevice::init("_Gate"); 
  
  // 設定為穩定的中等功率 -12 dBm (對應 ESP_PWR_LVL_N12)
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N12); 
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_DEFAULT, ESP_PWR_LVL_N12); 

  // 2. 建立 BLE 伺服器與服務
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());
  BLEService *pService = pServer->createService(SERVICE_UUID);

  // 3. 建立可寫入的特徵值
  BLECharacteristic *pCharacteristic = pService->createCharacteristic(
                                         CHARACTERISTIC_UUID,
                                         BLECharacteristic::PROPERTY_WRITE
                                       );
  pCharacteristic->setCallbacks(new MyCallbacks());
  pService->start();

  // 4. 【相容性優化核心】重構廣播結構，將 UUID 寫入主廣播
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  
  // 主廣播包：強迫寫入 128-bit SERVICE_UUID，這樣網頁過濾才抓得到
  BLEAdvertisementData advData;
  advData.setFlags(0x06); 
  advData.setCompleteServices(BLEUUID(SERVICE_UUID)); 
  pAdvertising->setAdvertisementData(advData);

  // 掃描回應包：放入名稱 _Gate
  BLEAdvertisementData scanResponseData;
  scanResponseData.setName("_Gate");
  pAdvertising->setScanResponseData(scanResponseData);

  pAdvertising->setScanResponse(true);
  pAdvertising->setMinInterval(80); // 50ms 高頻廣播間隔
  pAdvertising->setMaxInterval(80); 
  pAdvertising->start();
  
  Serial.println("[藍牙] 高相容性 UUID 標準廣播中...");
  Serial.println("----------------------------------------------");
}

void loop() {
  delay(100);
}
