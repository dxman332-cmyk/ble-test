#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include <Preferences.h>
#include "esp_bt.h"

#define SERVICE_UUID            "4f475400-0000-0000-0000-000000000000" // 'OGT'
#define CHARACTERISTIC_UUID_KEY "b9eab6ea-0000-0000-0000-000000000000" // '門禁' 通道
#define CHARACTERISTIC_UUID_PWR "b9eab6eb-0000-0000-0000-000000000000" // '功率' 通道

HardwareSerial SerialCOM2(1);
#define RX2_PIN 2  // 連接 EKT010 的 TXD
#define TX2_PIN 3  // 連接 EKT010 的 RXD

Preferences preferences;
int current_pwr_level = 12; // 預設 12 (-12 dBm)

// 【修正核心 1】回歸使用 ESP32-C3 官方唯一認得的硬體功率控制函數
void applyBluetoothPower(int pwr) {
  if (pwr == 24) esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N24);
  else if (pwr == 21) esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N21);
  else if (pwr == 18) esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N18);
  else if (pwr == 15) esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N15);
  else if (pwr == 12) esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N12);
  else if (pwr == 9)  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N9);
  else if (pwr == 6)  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N6);
  else if (pwr == 3)  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N3);
  else if (pwr == 0)  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N0);
  else {
    esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N12);
  }
}

// 藍牙通道 1 回呼：手機貼緊發送密文
class MyCallbacks: public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic *pCharacteristic) {
      String encryptedToken = pCharacteristic->getValue().c_str();
      encryptedToken.trim(); 

      if (encryptedToken.length() > 0) {
        Serial.println("----------------------------------------------");
        Serial.print("[藍牙接收] 密文: "); Serial.println(encryptedToken);
        
        // 透過 485 有線網路甩給局域網中心伺服器
        SerialCOM2.println(encryptedToken); 
        Serial.println("[485發送] 密文已成功甩入有線網絡。");
        Serial.println("----------------------------------------------");
        
        // 【修正核心 2】開門後延時 0.5 秒直接強行重啟！
        // 這是唯一能 100% 暴力切斷手機藍牙快取死鎖、讓網頁下一次絕對看得到 _Gate 的真理！
        delay(500);
        ESP.restart();
      }
    }
};

// 藍牙通道 2 回呼：處理手機網頁直接透過藍牙修改發射功率
class MyPwrCallbacks: public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic *pChar) {
      String cmd = pChar->getValue().c_str();
      cmd.trim();
      if (cmd.startsWith("SET_PWR:")) {
        int new_pwr = cmd.substring(8).toInt();
        
        // 寫入永久快閃記憶體
        preferences.begin("ogt_config", false);
        preferences.putInt("pwr_level", new_pwr);
        preferences.end();
        
        Serial.println("\n----------------------------------------------");
        Serial.print("[藍牙配置] 成功修改功率為: -"); Serial.print(new_pwr); Serial.println(" dBm");
        Serial.println("[系統] 硬體快閃記憶體已永久儲存，晶片即將重啟生效...");
        Serial.println("----------------------------------------------");
        
        delay(800);
        ESP.restart(); // 功率修改後強制重啟，讓 setup() 重新載入新功率
      }
    }
};

void setup() {
  Serial.begin(115200);
  delay(1000); 
  Serial.println("\n==============================================");
  Serial.println("=== OGT 智能門禁通用系統 [有線+藍牙雙向配置版] ===");
  Serial.println("==============================================");
  
  SerialCOM2.begin(115200, SERIAL_8N1, RX2_PIN, TX2_PIN);

  // 讀取快閃記憶體中的功率設定
  preferences.begin("ogt_config", false);
  current_pwr_level = preferences.getInt("pwr_level", 12); // 預設讀取 -12 dBm
  preferences.end();

  // 1. 初始化標準藍牙（拋棄不相容的 NimBLE）
  BLEDevice::init("_Gate"); 
  
  // 2. 核心功率套用
  applyBluetoothPower(current_pwr_level);

  BLEServer *pServer = BLEDevice::createServer();
  pServer->setCallbacks(NULL); // 移除不穩定連線回呼，確保極致穩定
  
  BLEService *pService = pServer->createService(SERVICE_UUID);

  // 3. 建立開鎖通道
  BLECharacteristic *pCharKey = pService->createCharacteristic(CHARACTERISTIC_UUID_KEY, BLECharacteristic::PROPERTY_WRITE);
  pCharKey->setCallbacks(new MyCallbacks());

  // 4. 建立改功率通道
  BLECharacteristic *pCharPwr = pService->createCharacteristic(CHARACTERISTIC_UUID_PWR, BLECharacteristic::PROPERTY_WRITE);
  pCharPwr->setCallbacks(new MyPwrCallbacks());

  pService->start();

  // 5. 設定標準廣播
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinInterval(80); // 50ms 超高速廣播
  pAdvertising->setMaxInterval(80); 
  pAdvertising->start();
  
  Serial.print("[記憶讀取] 廣播名稱：_Gate，當前發射功率：-"); 
  Serial.print(current_pwr_level); Serial.println(" dBm");
  Serial.println("[系統] 485 有線轉發與網頁藍牙雙防線調試就緒...");
  Serial.println("----------------------------------------------");
}

void loop() {
  // 5. 局域網有線網路改功率指令（由網聯下發）
  if (SerialCOM2.available() > 0) {
    String cmd = SerialCOM2.readStringUntil('\n'); cmd.trim();
    if (cmd.startsWith("SET_PWR:")) {
      int new_pwr = cmd.substring(8).toInt();
      
      Serial.println("\n----------------------------------------------");
      Serial.print("[485 網絡指令] 收到遠端網聯更改功率請求: -");
      Serial.print(new_pwr); Serial.println(" dBm");
      
      preferences.begin("ogt_config", false); 
      preferences.putInt("pwr_level", new_pwr); 
      preferences.end();
      
      Serial.println("[系統] 網路下發功率已成功寫入快閃記憶體，1 秒後重啟...");
      Serial.println("----------------------------------------------");
      delay(1000);
      ESP.restart(); // 網絡更改成功後重啟套用
    }
  }
  delay(100);
}
