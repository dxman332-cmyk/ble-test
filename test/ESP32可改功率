#include <NimBLEDevice.h> // 【終極優化】改用高效能、免重啟的 NimBLE 庫
#include <Preferences.h>
#include "esp_bt.h"

#define SERVICE_UUID            "4f475400-0000-0000-0000-000000000000" // 'OGT'
#define CHARACTERISTIC_UUID_KEY "b9eab6ea-0000-0000-0000-000000000000" // '門禁' 通道
#define CHARACTERISTIC_UUID_PWR "b9eab6eb-0000-0000-0000-000000000000" // '功率' 通道

HardwareSerial SerialCOM2(1);
#define RX2_PIN 2  
#define TX2_PIN 3  

Preferences preferences;
int current_pwr_level = 12; 
BLEServer *pServer = NULL;

void applyBluetoothPower(int pwr) {
  if (pwr == 24) NimBLEDevice::setPower(ESP_PWR_LVL_N24);
  else if (pwr == 21) NimBLEDevice::setPower(ESP_PWR_LVL_N21);
  else if (pwr == 18) NimBLEDevice::setPower(ESP_PWR_LVL_N18);
  else if (pwr == 15) NimBLEDevice::setPower(ESP_PWR_LVL_N15);
  else if (pwr == 12) NimBLEDevice::setPower(ESP_PWR_LVL_N12);
  else if (pwr == 9)  NimBLEDevice::setPower(ESP_PWR_LVL_N9);
  else if (pwr == 6)  NimBLEDevice::setPower(ESP_PWR_LVL_N6);
  else if (pwr == 3)  NimBLEDevice::setPower(ESP_PWR_LVL_N3);
  else if (pwr == 0)  NimBLEDevice::setPower(ESP_PWR_LVL_N0);
  else {
    NimBLEDevice::setPower(ESP_PWR_LVL_N12);
  }
}

// 監聽大門連線狀態：一斷開連線，0 毫秒立刻原地復活，重新開始發射廣播！
class OgtServerCallbacks: public NimBLEServerCallbacks {
    void onDisconnect(NimBLEServer* pServer) {
        // 【核心免重啟防線】斷開連線後秒開啟廣播，不需經歷漫長的重新開機
        NimBLEDevice::startAdvertising();
        Serial.println("[系統通知] 手機已離場，藍牙雷達廣播已於 0 毫秒內同步重新部署！");
    }
};

// 藍牙通道 1：處理手機貼緊轉發 485 密文
class MyCallbacks: public NimBLECharacteristicCallbacks {
    void onWrite(NimBLECharacteristic *pCharacteristic) {
      String encryptedToken = pCharacteristic->getValue().c_str();
      encryptedToken.trim(); 

      if (encryptedToken.length() > 0) {
        Serial.println("----------------------------------------------");
        Serial.print("[藍牙接收] 密文: "); Serial.println(encryptedToken);
        
        // 透過 485 有線網路砸給局域網中心伺服器解密
        SerialCOM2.println(encryptedToken); 
        Serial.println("[485發送] 密文已甩入有線網絡。");
        Serial.println("----------------------------------------------");
        
        // 【注意】這裡不再重啟 (ESP.restart() 已拿掉)！
        // 網頁或 App 端會在 0.5 秒內自動下發 disconnect()，直接觸發上方的 onDisconnect 原地復活！
      }
    }
};

// 藍牙通道 2：處理網頁滑桿直接修改發射功率
class MyPwrCallbacks: public NimBLECharacteristicCallbacks {
    void onWrite(NimBLECharacteristic *pCharacteristic) {
      String cmd = pCharacteristic->getValue().c_str();
      cmd.trim();
      if (cmd.startsWith("SET_PWR:")) {
        int new_pwr = cmd.substring(8).toInt();
        preferences.begin("ogt_config", false);
        preferences.putInt("pwr_level", new_pwr);
        preferences.end();
        Serial.print("\n[藍牙配置] 成功修改功率為: -"); Serial.print(new_pwr); Serial.println(" dBm");
        
        // 動態即時變更功率，免重啟！
        applyBluetoothPower(new_pwr); 
        Serial.println("[系統] 功率已動態即時生效，免重啟復位！");
      }
    }
};

void setup() {
  Serial.begin(115200);
  delay(500); 
  Serial.println("\n==============================================");
  Serial.println("=== OGT 智能門禁通用系統 [NimBLE 零延遲工業版] ===");
  Serial.println("==============================================");
  
  SerialCOM2.begin(115200, SERIAL_8N1, RX2_PIN, TX2_PIN);

  preferences.begin("ogt_config", false);
  current_pwr_level = preferences.getInt("pwr_level", 12);
  preferences.end();

  // 1. 初始化 NimBLE 藍牙
  NimBLEDevice::init("_Gate"); 
  applyBluetoothPower(current_pwr_level);

  // 2. 建立伺服器並綁定「秒斷開重新廣播」回呼
  pServer = NimBLEDevice::createServer();
  pServer->setCallbacks(new OgtServerCallbacks());
  
  NimBLEService *pService = pServer->createService(SERVICE_UUID);

  // 3. 建立開鎖通道
  NimBLECharacteristic *pCharKey = pService->createCharacteristic(CHAR_KEY_UUID, NIMBLE_PROPERTY::WRITE);
  pCharKey->setCallbacks(new MyCallbacks());

  // 4. 建立改功率通道
  NimBLECharacteristic *pCharPwr = pService->createCharacteristic(CHAR_PWR_UUID, NIMBLE_PROPERTY::WRITE);
  pCharPwr->setCallbacks(new MyPwrCallbacks());

  pService->start();

  // 5. 配置高速廣播
  NimBLEAdvertising *pAdvertising = NimBLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinInterval(80); // 50ms 超高速廣播
  pAdvertising->setMaxInterval(80); 
  pAdvertising->start();
  
  Serial.print("[記憶讀取] 當前發射功率：-"); Serial.print(current_pwr_level); Serial.println(" dBm");
  Serial.println("[系統] 485 有線轉發就緒，NimBLE 24小時不間斷監聽中...");
  Serial.println("----------------------------------------------");
}

void loop() {
  // 局域網有線網路改功率指令同步支援，此處同樣優化為免重啟、動態即時生效！
  if (SerialCOM2.available() > 0) {
    String cmd = SerialCOM2.readStringUntil('\n'); cmd.trim();
    if (cmd.startsWith("SET_PWR:")) {
      int new_pwr = cmd.substring(8).toInt();
      preferences.begin("ogt_config", false); preferences.putInt("pwr_level", new_pwr); preferences.end();
      applyBluetoothPower(new_pwr);
      Serial.print("\n[網絡有線指令] 成功更改功率為: -"); Serial.print(new_pwr); Serial.println(" dBm");
    }
  }
  delay(100);
}
