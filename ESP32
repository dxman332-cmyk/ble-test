#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include "esp_bt.h"

#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

#define RELAY_PIN 5  

bool deviceConnected = false;

// 【核心新增】建立監聽藍牙傳來數據的回呼函式
class MyCallbacks: public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic *pCharacteristic) {
      // 讀取手機藍牙直接傳過來的字串
      String value = pCharacteristic->getValue().c_str();
      value.trim(); // 去除前後空白與換行

      if (value.length() > 0) {
        Serial.println("----------------------------------------------");
        Serial.print("[藍牙串口接收] 收到來自手機網頁的指令: \"");
        Serial.print(value);
        Serial.println("\"");
        
        // 判定開門字串
        if (value == "OPEN") {
          Serial.println(">>> [驗證成功] 格式密碼正確！驅動大門解鎖 2 秒！ <<<");
          digitalWrite(RELAY_PIN, HIGH); // 開鎖
          delay(2000);                   // 保持開鎖 2 秒
          digitalWrite(RELAY_PIN, LOW);  // 關鎖
          Serial.println(">>> 鎖具已自動重新上鎖。 <<<");
        } else {
          Serial.println("[-] 密碼字串不符，拒絕開門。");
        }
        Serial.println("----------------------------------------------");
      }
    }
};

// 監聽手機連線狀態
class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      deviceConnected = true;
      Serial.println("\n[系統通知] 手機已成功建立藍牙連線。");
    };
    void onDisconnect(BLEServer* pServer) {
      deviceConnected = false;
      Serial.println("[系統通知] 手機已斷開藍牙連線。");
      // 斷線後必須重新啟動廣播，下次才能再連
      pServer->startAdvertising(); 
    }
};

void setup() {
  Serial.begin(115200);
  delay(1500); 
  Serial.println("\n==============================================");
  Serial.println("=== Proton 門禁 [藍牙直接控制與串口調試] 啟動 ===");
  Serial.println("==============================================");
  
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW); 

  // 1. 初始化藍牙，設定名稱為 "Proton_Gate"（方便網頁精準連線，避免選錯 N/A）
  BLEDevice::init("_Gate"); 
  
  // 壓低發射功率到硬體最低極限 -24 dBm，限制物理範圍
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_N12); 

  // 2. 建立 BLE 伺服器與服務
  BLEServer *pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());
  
  BLEService *pService = pServer->createService(SERVICE_UUID);

  // 3. 建立可寫入的特徵值，並綁定數據監聽器
  BLECharacteristic *pCharacteristic = pService->createCharacteristic(
                                         CHARACTERISTIC_UUID,
                                         BLECharacteristic::PROPERTY_WRITE
                                       );
  pCharacteristic->setCallbacks(new MyCallbacks());
  pService->start();

  // 4. 設定廣播
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  
  // 50ms 超高速廣播間隔
  pAdvertising->setMinInterval(80); 
  pAdvertising->setMaxInterval(80); 
  pAdvertising->start();
  
  Serial.println("[藍牙] 物理功率已壓至最低 (-24 dBm)，高頻廣播中...");
  Serial.println("[提示] 請配合對應的網頁端點擊開門，並觀察下方窗口。");
  Serial.println("----------------------------------------------");
}

void loop() {
  delay(1000);
}
